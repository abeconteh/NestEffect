<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>NestEffect Group — Building Tomorrow</title>
<meta name="description" content="NestEffect Group is a collective of impact-driven enterprises spanning housing, clean energy, battery recycling, ethical finance, and community relief." />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;0,900;1,400;1,600&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
<style>
  :root{
    --crimson-400:#e05858; --crimson-500:#c93434; --crimson-600:#a52424; --crimson-700:#8B1A1A; --crimson-900:#4d0e0e;
    --ink-800:#2a2620; --ink-900:#1c1a16; --ink-950:#121212;
    --cream-100:#F9F6F0;
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth; -webkit-font-smoothing:antialiased;}
  body{margin:0; background:var(--ink-950); color:var(--cream-100); font-family:'Inter',system-ui,sans-serif; font-feature-settings:'cv11','ss01';}
  a{color:inherit; text-decoration:none;}
  button{font-family:inherit; cursor:pointer;}
  ::selection{background:var(--crimson-700); color:var(--cream-100);}
  ::-webkit-scrollbar{width:10px;}
  ::-webkit-scrollbar-track{background:#121212;}
  ::-webkit-scrollbar-thumb{background:#2a2620; border-radius:5px;}
  ::-webkit-scrollbar-thumb:hover{background:#8B1A1A;}

  .heading-serif{font-family:'Playfair Display',Georgia,serif; font-weight:700; letter-spacing:-0.01em;}
  .container-luxe{margin:0 auto; width:100%; max-width:80rem; padding:0 1.5rem;}
  @media(min-width:640px){.container-luxe{padding:0 2rem;}}
  @media(min-width:1024px){.container-luxe{padding:0 3rem;}}

  .section-label{display:inline-flex; align-items:center; gap:.5rem; font-size:.75rem; font-weight:600; text-transform:uppercase; letter-spacing:.25em; color:var(--crimson-400);}
  .card-surface{border-radius:1rem; border:1px solid rgba(249,246,240,.1); background:rgba(28,26,22,.4); backdrop-filter:blur(4px);}
  .btn-crimson{display:inline-flex; align-items:center; justify-content:center; gap:.5rem; border-radius:.5rem; background:var(--crimson-700); padding:.875rem 1.5rem; font-size:.875rem; font-weight:600; text-transform:uppercase; letter-spacing:.05em; color:var(--cream-100); border:none; transition:all .3s; }
  .btn-crimson:hover{background:var(--crimson-600); box-shadow:0 10px 25px -5px rgba(139,26,26,.3);}
  .btn-crimson:active{transform:scale(.98);}
  .btn-ghost{display:inline-flex; align-items:center; justify-content:center; gap:.5rem; border-radius:.5rem; border:1px solid rgba(249,246,240,.2); background:transparent; padding:.875rem 1.5rem; font-size:.875rem; font-weight:600; text-transform:uppercase; letter-spacing:.05em; color:var(--cream-100); transition:all .3s;}
  .btn-ghost:hover{border-color:rgba(249,246,240,.4); background:rgba(249,246,240,.05);}
  .btn-ghost:active{transform:scale(.98);}
  .input-luxe{width:100%; border-radius:.5rem; border:1px solid rgba(249,246,240,.15); background:rgba(28,26,22,.6); padding:.875rem 1rem; color:var(--cream-100); font-size:.95rem; transition:all .2s; font-family:inherit;}
  .input-luxe::placeholder{color:rgba(249,246,240,.4);}
  .input-luxe:focus{border-color:var(--crimson-500); outline:none; box-shadow:0 0 0 1px var(--crimson-500);}

  .bg-grid{background-image:linear-gradient(to right, rgba(249,246,240,.03) 1px, transparent 1px), linear-gradient(to bottom, rgba(249,246,240,.03) 1px, transparent 1px); background-size:64px 64px;}
  .bg-radial-crimson{background:radial-gradient(ellipse 80% 50% at 50% 0%, rgba(139,26,26,.15), transparent 70%);}

  @keyframes fadeInUp{0%{opacity:0; transform:translateY(30px);} 100%{opacity:1; transform:translateY(0);}}
  @keyframes fadeIn{0%{opacity:0;} 100%{opacity:1;}}
  @keyframes pulseSlow{0%,100%{opacity:1;} 50%{opacity:.6;}}
  .animate-fade-in-up{animation:fadeInUp .8s ease-out forwards; opacity:0;}
  .animate-fade-in{animation:fadeIn .6s ease-out forwards;}
  .animate-pulse-slow{animation:pulseSlow 3s ease-in-out infinite;}

  .icon{width:1em; height:1em; display:inline-block; vertical-align:middle; stroke:currentColor; fill:none; stroke-width:2; stroke-linecap:round; stroke-linejoin:round;}

  /* Navbar */
  header{position:fixed; top:0; left:0; right:0; z-index:50; transition:all .5s;}
  header.scrolled{background:rgba(18,18,18,.85); backdrop-filter:blur(20px); border-bottom:1px solid rgba(249,246,240,.05);}
  nav.navwrap{display:flex; align-items:center; justify-content:space-between; padding:1.25rem 0;}
  .brand{display:flex; align-items:center; gap:.65rem;}
  .brand-icon{display:flex; height:2.25rem; width:2.25rem; align-items:center; justify-content:center; border-radius:.5rem; background:var(--crimson-700); transition:transform .3s; flex-shrink:0;}
  .brand:hover .brand-icon{transform:scale(1.05);}
  .brand-name{font-size:1.125rem; line-height:1;}
  .brand-sub{font-size:10px; text-transform:uppercase; letter-spacing:.2em; color:rgba(249,246,240,.4); margin-top:.125rem;}
  .navlinks{display:none; align-items:center; gap:2rem;}
  @media(min-width:768px){.navlinks{display:flex;}}
  .navlinks a{font-size:.875rem; font-weight:500; color:rgba(249,246,240,.7); transition:color .2s;}
  .navlinks a:hover{color:var(--cream-100);}
  .navbtn-crimson{padding:.625rem 1.25rem !important;}
  .menu-toggle{display:block; background:none; border:none; color:var(--cream-100);}
  @media(min-width:768px){.menu-toggle{display:none;}}
  .mobile-menu{display:none; background:rgba(18,18,18,.95); backdrop-filter:blur(20px); border-top:1px solid rgba(249,246,240,.05);}
  .mobile-menu.open{display:block;}
  .mobile-menu-inner{display:flex; flex-direction:column; gap:1rem; padding:1.5rem 0;}
  .mobile-menu-inner a{font-size:.875rem; font-weight:500; color:rgba(249,246,240,.7);}
  .mobile-menu-inner a:hover{color:var(--cream-100);}

  /* Hero */
  #top{position:relative; min-height:100vh; overflow:hidden; background:var(--ink-950);}
  .hero-inner{position:relative; z-index:10; display:flex; min-height:100vh; flex-direction:column; justify-content:center; padding-top:8rem; padding-bottom:5rem;}
  .hero-copy{max-width:60rem;}
  h1.hero-title{font-size:2.25rem; line-height:1.15; margin:0;}
  @media(min-width:640px){h1.hero-title{font-size:2.75rem;}}
  @media(min-width:768px){h1.hero-title{font-size:3.25rem;}}
  @media(min-width:1024px){h1.hero-title{font-size:4rem;}}
  .accent-red{color:var(--crimson-500);}
  .accent-underline{text-decoration:underline; text-decoration-color:var(--crimson-500); text-decoration-thickness:3px; text-underline-offset:8px;}
  .hero-desc{margin-top:2rem; max-width:40rem; font-size:1.125rem; color:rgba(249,246,240,.6); line-height:1.7;}
  @media(min-width:640px){.hero-desc{font-size:1.25rem;}}
  .hero-actions{margin-top:2.5rem; display:flex; flex-wrap:wrap; gap:1rem;}
  .hero-grid{margin-top:4rem; display:grid; grid-template-columns:repeat(2,1fr); gap:.75rem;}
  @media(min-width:640px){.hero-grid{grid-template-columns:repeat(3,1fr);}}
  @media(min-width:1024px){.hero-grid{grid-template-columns:repeat(6,1fr);}}
  .hero-card{display:flex; flex-direction:column; align-items:center; gap:.75rem; padding:1.25rem; text-align:center; transition:all .3s; border:1px solid rgba(249,246,240,.1);}
  .hero-card:hover{border-color:rgba(139,26,26,.4); background:rgba(28,26,22,.6);}
  .hero-card-icon{display:flex; height:2.75rem; width:2.75rem; align-items:center; justify-content:center; border-radius:.5rem; background:var(--ink-800); color:rgba(249,246,240,.6); transition:all .3s; font-size:1.15rem;}
  .hero-card:hover .hero-card-icon{background:var(--crimson-700); color:var(--cream-100);}
  .hero-card span{font-size:.75rem; font-weight:600; color:rgba(249,246,240,.7);}
  .hero-card:hover span{color:var(--cream-100);}
  .scroll-indicator{position:absolute; bottom:2rem; left:50%; transform:translateX(-50%); z-index:10; display:flex; flex-direction:column; align-items:center; gap:.5rem; color:rgba(249,246,240,.3);}
  .scroll-indicator span{font-size:.75rem; text-transform:uppercase; letter-spacing:.2em;}
  .scroll-line{height:3rem; width:1px; background:linear-gradient(to bottom, rgba(249,246,240,.3), transparent);}

  section{position:relative;}
  .bg-grid-overlay{position:absolute; inset:0; opacity:.3;}

  /* Business tabs section */
  #businesses{background:var(--ink-950); padding:6rem 0;}
  @media(min-width:640px){#businesses{padding:8rem 0;}}
  .sec-heading{max-width:48rem;}
  .sec-heading h2{font-size:2.25rem; line-height:1.1; margin:0;}
  @media(min-width:640px){.sec-heading h2{font-size:3rem;}}
  @media(min-width:768px){.sec-heading h2{font-size:3.75rem;}}
  .sec-heading p{margin-top:1.5rem; font-size:1.125rem; color:rgba(249,246,240,.5); line-height:1.7;}
  .muted{color:rgba(249,246,240,.4);}

  .biz-tabs{margin-top:3rem; display:flex; flex-wrap:wrap; gap:.5rem;}
  @media(min-width:640px){.biz-tabs{gap:.75rem;}}
  .biz-tab{display:flex; align-items:center; gap:.6rem; border-radius:.75rem; padding:.75rem 1rem; font-size:.875rem; font-weight:600; transition:all .3s; border:1px solid rgba(249,246,240,.1); background:rgba(28,26,22,.4); color:rgba(249,246,240,.6);}
  .biz-tab:hover{border-color:rgba(249,246,240,.2); color:var(--cream-100);}
  .biz-tab.active{background:var(--crimson-700); color:var(--cream-100); border-color:var(--crimson-700); box-shadow:0 10px 15px -3px rgba(139,26,26,.2);}
  .biz-tab .short{display:inline;}
  .biz-tab .full{display:none;}
  @media(min-width:640px){.biz-tab .short{display:none;} .biz-tab .full{display:inline;}}

  .biz-panel{margin-top:2rem; display:grid; grid-template-columns:1fr; gap:1.5rem;}
  @media(min-width:1024px){.biz-panel{grid-template-columns:2fr 3fr;}}
  .biz-media{overflow:hidden; height:100%;}
  .biz-media-inner{position:relative; aspect-ratio:4/3; overflow:hidden; background:var(--ink-800);}
  .biz-media-inner img{height:100%; width:100%; object-fit:cover; display:block;}
  .biz-media-overlay{position:absolute; inset:0; background:linear-gradient(to top, var(--ink-950), rgba(18,18,18,.3), transparent);}
  .biz-media-caption{position:absolute; bottom:0; left:0; right:0; padding:1.5rem;}
  .biz-media-icon{margin-bottom:.75rem; display:flex; height:3rem; width:3rem; align-items:center; justify-content:center; border-radius:.75rem; background:var(--crimson-700); color:var(--cream-100); font-size:1.35rem;}
  .biz-media-caption h3{margin:0; font-size:1.5rem;}
  .biz-media-caption p{margin:.25rem 0 0; font-size:.875rem; color:rgba(249,246,240,.6);}

  .biz-detail{height:100%; padding:1.5rem;}
  @media(min-width:640px){.biz-detail{padding:2rem;}}
  .subtabs{display:flex; flex-wrap:wrap; gap:.25rem; border-bottom:1px solid rgba(249,246,240,.1); padding-bottom:1rem; margin-bottom:1.5rem;}
  .subtab{border-radius:.5rem; padding:.5rem 1rem; font-size:.875rem; font-weight:500; transition:all .2s; background:none; border:none; color:rgba(249,246,240,.5);}
  .subtab:hover{color:rgba(249,246,240,.8);}
  .subtab.active{background:rgba(139,26,26,.15); color:var(--crimson-400);}
  .subtab-content h4{font-size:1.5rem; line-height:1.25; margin:0 0 1rem;}
  @media(min-width:640px){.subtab-content h4{font-size:1.875rem;}}
  .subtab-content > p{color:rgba(249,246,240,.6); line-height:1.7;}
  .subtab-bullets{margin-top:1.5rem; list-style:none; padding:0; display:flex; flex-direction:column; gap:.75rem;}
  .subtab-bullets li{display:flex; align-items:flex-start; gap:.75rem;}
  .subtab-bullets .dot{margin-top:.5rem; height:.375rem; width:.375rem; flex-shrink:0; border-radius:50%; background:var(--crimson-500);}
  .subtab-bullets span.txt{font-size:.875rem; color:rgba(249,246,240,.7); line-height:1.6;}
  .keyfocus-grid{margin-top:2rem; display:grid; grid-template-columns:repeat(2,1fr); gap:.75rem;}
  .keyfocus-item{border-radius:.5rem; border:1px solid rgba(249,246,240,.1); background:rgba(28,26,22,.4); padding:.75rem 1rem;}
  .keyfocus-item span{font-size:.875rem; font-weight:500; color:rgba(249,246,240,.8);}
  .biz-footer-link{margin-top:2rem; padding-top:1.5rem; border-top:1px solid rgba(249,246,240,.05);}
  .biz-footer-link a{display:inline-flex; align-items:center; gap:.5rem; font-size:.875rem; font-weight:600; color:var(--crimson-500);}
  .biz-footer-link a:hover{color:var(--crimson-400);}

  /* About section */
  #about{background:var(--ink-900); padding:6rem 0;}
  @media(min-width:640px){#about{padding:8rem 0;}}
  .about-grid{display:grid; grid-template-columns:1fr; gap:3rem; align-items:start;}
  @media(min-width:1024px){.about-grid{grid-template-columns:1fr 1fr;}}
  .about-heading h2{font-size:2.25rem; line-height:1.1; margin:0;}
  @media(min-width:640px){.about-heading h2{font-size:3rem;}}
  .about-heading p{margin-top:1.5rem; font-size:1.125rem; color:rgba(249,246,240,.5); line-height:1.7;}
  .stats-grid{margin-top:2.5rem; display:grid; grid-template-columns:repeat(2,1fr); gap:1rem;}
  @media(min-width:640px){.stats-grid{grid-template-columns:repeat(4,1fr);}}
  .stat-card{padding:1.25rem; text-align:center;}
  .stat-value{font-size:1.875rem; color:var(--crimson-500);}
  .stat-label{margin-top:.25rem; font-size:.75rem; color:rgba(249,246,240,.5); text-transform:uppercase; letter-spacing:.05em;}
  .pillars-grid{display:grid; grid-template-columns:1fr; gap:1rem;}
  @media(min-width:640px){.pillars-grid{grid-template-columns:repeat(2,1fr);}}
  .pillar-card{padding:1.5rem; transition:all .3s;}
  .pillar-card:hover{border-color:rgba(139,26,26,.3); background:rgba(42,38,32,.5);}
  .pillar-icon{margin-bottom:1rem; display:flex; height:2.75rem; width:2.75rem; align-items:center; justify-content:center; border-radius:.5rem; background:rgba(139,26,26,.1); color:var(--crimson-500); transition:all .3s; font-size:1.2rem;}
  .pillar-card:hover .pillar-icon{background:var(--crimson-700); color:var(--cream-100);}
  .pillar-card h3{font-size:1.125rem; margin:0 0 .5rem;}
  .pillar-card p{font-size:.875rem; color:rgba(249,246,240,.5); line-height:1.6; margin:0;}

  /* Contact */
  #contact{background:var(--ink-950); padding:6rem 0;}
  @media(min-width:640px){#contact{padding:8rem 0;}}
  .contact-glow{position:absolute; top:0; left:50%; transform:translateX(-50%); height:16rem; width:600px; border-radius:9999px; background:rgba(139,26,26,.1); filter:blur(64px);}
  .contact-head{margin:0 auto; max-width:42rem; text-align:center;}
  .contact-head .section-label{justify-content:center;}
  .contact-head h2{font-size:2.25rem; line-height:1.1; margin:0;}
  @media(min-width:640px){.contact-head h2{font-size:3rem;}}
  .contact-head p{margin-top:1.5rem; font-size:1.125rem; color:rgba(249,246,240,.5); line-height:1.7;}
  .contact-cards{margin:3rem auto 0; max-width:48rem; display:grid; grid-template-columns:1fr; gap:1rem;}
  @media(min-width:640px){.contact-cards{grid-template-columns:repeat(3,1fr);}}
  .contact-card{display:flex; flex-direction:column; align-items:center; gap:.75rem; padding:2rem; text-align:center; transition:all .3s;}
  .contact-card:hover{border-color:rgba(139,26,26,.3); background:rgba(28,26,22,.5);}
  .contact-card-icon{display:flex; height:3rem; width:3rem; align-items:center; justify-content:center; border-radius:.75rem; background:rgba(139,26,26,.1); color:var(--crimson-500); transition:all .3s; font-size:1.3rem;}
  .contact-card:hover .contact-card-icon{background:var(--crimson-700); color:var(--cream-100);}
  .contact-card-label{font-size:.75rem; text-transform:uppercase; letter-spacing:.05em; color:rgba(249,246,240,.4); margin-bottom:.25rem;}
  .contact-card-value{font-size:.875rem; font-weight:500; color:var(--cream-100);}
  .contact-form-wrap{margin:3rem auto 0; max-width:42rem;}
  .contact-form-card{padding:2rem;}
  @media(min-width:640px){.contact-form-card{padding:2.5rem;}}
  .contact-form-card h3{font-size:1.5rem; margin:0 0 1.5rem;}
  form.contact-form{display:grid; grid-template-columns:1fr; gap:1.25rem;}
  @media(min-width:640px){form.contact-form{grid-template-columns:1fr 1fr;}}
  .field label{display:block; margin-bottom:.5rem; font-size:.75rem; font-weight:600; text-transform:uppercase; letter-spacing:.05em; color:rgba(249,246,240,.6);}
  .field.full{grid-column:1/-1;}
  textarea.input-luxe{resize:none; font-family:inherit;}

  /* Footer */
  footer{background:var(--ink-950); border-top:1px solid rgba(249,246,240,.05); padding:4rem 0;}
  .footer-grid{display:grid; grid-template-columns:1fr; gap:2.5rem;}
  @media(min-width:768px){.footer-grid{grid-template-columns:repeat(5,1fr);}}
  .footer-brand{grid-column:span 1;}
  @media(min-width:768px){.footer-brand{grid-column:span 2;}}
  .footer-brand-row{display:flex; align-items:center; gap:.65rem; margin-bottom:1rem;}
  .footer-brand-row span{font-size:1.25rem;}
  .footer-brand p{font-size:.875rem; color:rgba(249,246,240,.4); line-height:1.7; max-width:24rem; margin:0;}
  .footer-social{margin-top:1.5rem; display:flex; gap:.75rem;}
  .footer-social a{display:flex; height:2.25rem; width:2.25rem; align-items:center; justify-content:center; border-radius:.5rem; border:1px solid rgba(249,246,240,.1); color:rgba(249,246,240,.4); transition:all .3s; font-size:1rem;}
  .footer-social a:hover{border-color:rgba(139,26,26,.4); color:var(--crimson-500);}
  .footer-col{grid-column:span 1;}
  @media(min-width:768px){.footer-col.wide{grid-column:span 2;}}
  .footer-col h4{font-size:.75rem; font-weight:600; text-transform:uppercase; letter-spacing:.05em; color:rgba(249,246,240,.6); margin:0 0 1rem;}
  .footer-col ul{list-style:none; padding:0; margin:0; font-size:.875rem; color:rgba(249,246,240,.4); display:flex; flex-direction:column; gap:.75rem;}
  .footer-col ul.biz-list{display:grid; grid-template-columns:1fr; gap:.75rem;}
  @media(min-width:640px){.footer-col ul.biz-list{grid-template-columns:repeat(2,1fr);}}
  .footer-col a:hover{color:var(--cream-100);}
  .footer-bottom{margin-top:3rem; padding-top:2rem; border-top:1px solid rgba(249,246,240,.05); display:flex; flex-direction:column; align-items:center; justify-content:space-between; gap:1rem;}
  @media(min-width:640px){.footer-bottom{flex-direction:row;}}
  .footer-bottom p{font-size:.75rem; color:rgba(249,246,240,.3); margin:0;}
  .footer-bottom-links{display:flex; gap:1.5rem; font-size:.75rem; color:rgba(249,246,240,.3);}
  .footer-bottom-links a:hover{color:var(--cream-100);}
</style>
</head>
