/* ---------- Events ---------- */
function attachEvents(){
  const header = document.getElementById('siteHeader');
  const onScroll = () => {
    if (window.scrollY > 40) header.classList.add('scrolled');
    else header.classList.remove('scrolled');
  };
  window.addEventListener('scroll', onScroll);
  onScroll();

  document.getElementById('menuToggle').addEventListener('click', () => {
    menuOpen = !menuOpen;
    render();
  });

  document.querySelectorAll('.mobile-link').forEach(el => {
    el.addEventListener('click', () => { menuOpen = false; render(); });
  });

  document.querySelectorAll('.jump-businesses').forEach(el => {
    el.addEventListener('click', (e) => {
      e.preventDefault();
      document.getElementById('businesses').scrollIntoView({behavior:'smooth'});
    });
  });

  document.querySelectorAll('.biz-tab').forEach(el => {
    el.addEventListener('click', () => {
      activeBusiness = el.dataset.biz;
      activeSubTab = 'overview';
      render();
      document.getElementById('businesses').scrollIntoView({behavior:'smooth', block:'start'});
    });
  });

  document.querySelectorAll('.subtab').forEach(el => {
    el.addEventListener('click', () => {
      activeSubTab = el.dataset.subtab;
      render();
    });
  });

  const form = document.getElementById('contactForm');
  if (form){
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      form.reset();
      alert("Thanks for reaching out! We'll be in touch soon.");
    });
  }
}

render();
</script>
